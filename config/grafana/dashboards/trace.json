{
  "uid": "contextweave-trace",
  "title": "ContextWeave 追踪与运行质量",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "contextweave"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "请求吞吐 / 秒",
      "datasource": {
        "type": "prometheus",
        "uid": "echomind-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(contextweave_requests_total[5m]))",
          "legendFormat": "{{model}} {{type}} {{stage}} {{tool}} {{currency}} {{price_version}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "对话 P95 / ms",
      "datasource": {
        "type": "prometheus",
        "uid": "echomind-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(contextweave_request_duration_ms_bucket[5m])))",
          "legendFormat": "{{model}} {{type}} {{stage}} {{tool}} {{currency}} {{price_version}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "错误和降级率",
      "datasource": {
        "type": "prometheus",
        "uid": "echomind-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(contextweave_requests_total{outcome=~\"error|degraded\"}[5m])) or vector(0)) / clamp_min(sum(rate(contextweave_requests_total[5m])), 0.001)",
          "legendFormat": "{{model}} {{type}} {{stage}} {{tool}} {{currency}} {{price_version}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Token 用量 / 秒（仅已知 usage）",
      "datasource": {
        "type": "prometheus",
        "uid": "echomind-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model,type) (rate(contextweave_llm_tokens_total[5m]))",
          "legendFormat": "{{model}} {{type}} {{stage}} {{tool}} {{currency}} {{price_version}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "费用估算 / 小时（按币种和价格版本）",
      "datasource": {
        "type": "prometheus",
        "uid": "echomind-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (currency,price_version) (rate(contextweave_llm_estimated_cost_total[5m])) * 3600",
          "legendFormat": "{{model}} {{type}} {{stage}} {{tool}} {{currency}} {{price_version}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "费用不可估算调用比例",
      "datasource": {
        "type": "prometheus",
        "uid": "echomind-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - (sum(rate(contextweave_llm_cost_known_total[5m])) or vector(0)) / clamp_min(sum(rate(contextweave_llm_calls_total[5m])), 0.001)) and sum(rate(contextweave_llm_calls_total[5m])) > 0",
          "legendFormat": "{{model}} {{type}} {{stage}} {{tool}} {{currency}} {{price_version}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "RAG 阶段 P95 / ms",
      "datasource": {
        "type": "prometheus",
        "uid": "echomind-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (stage,le) (rate(contextweave_rag_duration_ms_bucket[5m])))",
          "legendFormat": "{{model}} {{type}} {{stage}} {{tool}} {{currency}} {{price_version}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "工具降级 / 秒（MCP 层）",
      "datasource": {
        "type": "prometheus",
        "uid": "echomind-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool) (rate(contextweave_tool_fallbacks_total{layer=\"mcp\"}[5m]))",
          "legendFormat": "{{model}} {{type}} {{stage}} {{tool}} {{currency}} {{price_version}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "RAG 空结果 / 秒",
      "datasource": {
        "type": "prometheus",
        "uid": "echomind-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (rate(contextweave_rag_empty_results_total[5m]))",
          "legendFormat": "{{model}} {{type}} {{stage}} {{tool}} {{currency}} {{price_version}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "追踪导出失败 / 秒",
      "datasource": {
        "type": "prometheus",
        "uid": "echomind-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(contextweave_trace_export_failures_total[5m])",
          "legendFormat": "{{model}} {{type}} {{stage}} {{tool}} {{currency}} {{price_version}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "全量指标采集状态（1=启用）",
      "datasource": {
        "type": "prometheus",
        "uid": "echomind-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "contextweave_metrics_capture_enabled",
          "legendFormat": "{{model}} {{type}} {{stage}} {{tool}} {{currency}} {{price_version}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "模型 P95 / ms",
      "datasource": {
        "type": "prometheus",
        "uid": "echomind-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (model,le) (rate(contextweave_llm_duration_ms_bucket[5m])))",
          "legendFormat": "{{model}} {{type}} {{stage}} {{tool}} {{currency}} {{price_version}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
