# EchoMind 环境变量
# docker compose 部署时会自动读取此文件

# ── Anthropic / DeepSeek ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=xxx
ANTHROPIC_MODEL=deepseek-v4-pro
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# ── 应用 ──────────────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=echomind123
# docker compose 内部地址（容器间通信）
REDIS_URL=redis://:echomind123@redis:6379/0

# ── ChromaDB（情景记忆 + 用户画像）─────────────────────────────────────────────
# docker compose 内部地址（连接独立 ChromaDB 服务）
CHROMA_HOST=chromadb
CHROMA_PORT=8000
# 本地降级路径（仅 development；production 连接失败时中止启动）
CHROMA_PERSIST_DIRECTORY=/app/data/chroma
# 仅 development 自动导入示例政策；生产空库不会自动添加示例。
ECHOMIND_SEED_DEMO_DOCS=true

# ── 监控 ──────────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=0
MONITOR_INTERVAL=10
ALERT_WEBHOOK_URL=

# 每次模型请求的超时（秒）；聊天请求另有 50 秒总预算。
ECHOMIND_INTENT_TIMEOUT_S=8
ECHOMIND_LLM_TIMEOUT_S=15
ECHOMIND_COMPOSER_TIMEOUT_S=8

# ── 标准 MCP ─────────────────────────────────────────────────────────────────
# 默认连接无需 Key 的 Microsoft Learn 公开文档 MCP；设 false 可关闭外部连接。
MCP_EXTERNAL_ENABLED=true
# 不填时读取当前项目 config/mcp_servers.json，Docker 内默认路径同样可用。
# MCP_SERVERS_CONFIG=/app/config/mcp_servers.json
# 通过自定义域名访问 /mcp/ 时，将域名加入允许列表（逗号分隔）。
# MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,echomind,echomind:*,echomind-python,echomind-python:*,your-domain.example
# MCP_ALLOWED_ORIGINS=https://your-domain.example,http://localhost,http://localhost:*

# 本地默认 development；对外部署设置 production 并配置独立随机 API Token（不是模型 Key）。
ECHOMIND_ENV=development
# ECHOMIND_API_TOKENS={"至少24位随机Token":{"user_id":"u1","role":"user"},"另一管理员Token至少24位":{"user_id":"admin","role":"admin"}}

# 三路意图识别：有硅基流动 Key 自动启用当前免费版 BAAI/bge-m3；无 Key 使用本地 n-gram。
# 不使用收费的 Pro/BAAI/bge-m3，不与 ANTHROPIC_API_KEY 共用。
INTENT_EMBEDDING_PROVIDER=auto
SILICONFLOW_API_KEY=

# trace 分支增量：历史 Trace 接口也接受 ECHOMIND_API_TOKENS 中的 admin。
# TRACE_ADMIN_TOKEN=独立随机历史访问令牌
TRACE_POLICY_PATH=/app/config/observability.yml
# Collector 通过 docker-compose.observability.yml 启用。
OTEL_TRACES_EXPORTER=none
# 混合检索默认 Top 3；其他参数见 tooling/rag_config.py。
ECHOMIND_RAG_TOP_K=3
ECHOMIND_MEMORY_EVOLUTION_ENABLED=true
# 经验记忆开关，默认保留 trace 分支行为，见 docs/ExperienceMemory.md。
ECHOMIND_EXPERIENCE_ENABLED=true
